{
  "ConnectionStrings": {
    "DefaultConnection": "server=mysql;port=3306;database=offer_inventory;user=root;password=1234;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Services": {
    "UserApi": "http://user:8080",
    "BookingApi": "http://booking:5088"
  },

  "ReverseProxy": {
    "Routes": {
      "booking-signalr": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/hubs/booking/{**catch-all}"
        },
        "Transforms": [
          { "WebSocket": "true" }
        ]
      }
    },
    "Clusters": {
      "booking": {
        "Destinations": {
          "d1": {
            "Address": "http://booking:5088/"
          }
        }
      }
    }
  }
}
